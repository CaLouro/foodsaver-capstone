@model ItemListModel

@{
    ViewData["Title"] = $"{@Model.Business.Name} Listings";
}

<div class="dashboard-center-container">
    <div class="dashboard-selected-details d-flex justify-content-between">
        <div>
            <h4 style="margin:0; padding: 0;">@Model.Business.Name</h4>
            <p style="margin: 0;">@Model.Business.ContactEmail</p>
            <p style="margin: 0;">@Model.Business.ContactPhone</p>
        </div>
        <div>
            <span id="business-address-link"
                  onclick="redirectToMapsUrl('@Model.Business.Address.PresentAddress(true, true, true)')">
                <span id="business-address-text">
                    @Model.Business.Address.PresentAddress(true, true)
                </span>
                <i class="material-icons">place</i>
            </span>
        </div>
    </div>
    <div class="dashboard-navigation"
         style="height: 4.5rem;">
        <div class="v-center">
            <button class="dashboard-nav-button"
                    onclick="location.href='@Url.Action("Stores", "Dashboard")'">
                Stores
            </button>
            <button class="dashboard-nav-button"
                    onclick="location.href='@Url.Action("Deals", "Dashboard")'">
                Deals
            </button>
            <button class="dashboard-nav-button"
                    style="float:right; margin: 0;"
                    onclick="location.href='@Url.Action("Favorites", "Dashboard")'">
                Favorites
            </button>
        </div>
    </div>

    <div class="dashboard-results">
        @foreach (var deal in Model.Deals)
        {
            var item = deal.Item;

            <div class="dashboard-result-card">
                <div class="v-center d-flex justify-content-between" style="height:100%;">
                    <div class="card-text card-section-container"
                         style="width: 50%; padding-left: 3rem;">
                        <div class="v-center">
                            <h4>
                                @item.Name
                            </h4>
                            <p>Available at: @(deal.AvailabilityStarts == null ? "Now" : deal.AvailabilityStarts)</p>
                            <p>Ends at: @(deal.AvailabilityEnds == null ? "Never" : deal.AvailabilityEnds)</p>
                        </div>
                    </div>
                    <div class="card-text card-section-container"
                         style="width: 50%;">
                        <div class="v-center">
                            <p>@deal.Item.Description</p>
                        </div>
                    </div>
                    <div class="card-text card-section-container"
                         style="width: 30%;">
                        <div class="v-center">
                            <p style="font-size: 16px;">
                                @if (deal.Item.StandardPrice != null)
                                {
                                    <span class="regular-highlight">@($"{deal.Item.StandardPrice:c}")</span>
                                    <p>
                                        <span class="discount-highlight">@($"{deal.Price:c}")</span>
                                        &nbsp;(@($"{(deal.Item.StandardPrice - deal.Price) / deal.Item.StandardPrice:p0}") off)
                                    </p>
                                }
                                else
                                {
                                    <span>@($"{deal.Price:c}")</span>
                                }
                            </p>
                            @if (deal.QuantityAvailable != null)
                            {
                                <p style="font-size: 16px;">
                                    Availability: @deal.QuantityAvailable units
                                </p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Model.Deals.Count == 0)
        {
            <div class="d-flex justify-content-center"
                 style="padding: 1rem;">
                <h4 style="color:rgba(0, 0, 0, 0.4)">No available discounts</h4>
            </div>
        }
    </div>
</div>