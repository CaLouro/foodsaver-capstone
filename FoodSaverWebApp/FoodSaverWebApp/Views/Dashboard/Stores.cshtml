@model StoreDashboardModel

@{
    ViewData["Title"] = "Dashboard - Stores";
}

<div class="dashboard-center-container">
    <div class="dashboard-navigation"
         style="height: 4.5rem;">
        <div class="v-center">
            <button class="dashboard-nav-button dashboard-nav-button-active">Stores</button>
            <button class="dashboard-nav-button"
                    onclick="location.href='@Url.Action("Deals", "Dashboard")'">
                Products
            </button>
            <button class="dashboard-nav-button"
                    style="float:right; margin: 0;"
                    onclick="location.href='@Url.Action("Favorites", "Dashboard")'">
                Favorites
            </button>
        </div>
        <div class="h-center dashboard-nav-search-container">
            <div class="v-center d-flex justify-content-center">
                <span>
                    Search:
                    <input type="text"
                           class="dashboard-nav-search"
                           id="dashboardSearch"/>
                </span>
            </div>
        </div>
    </div>

    <div class="dashboard-results">
        @foreach (Business business in Model.Businesses)
        {
            <div class="dashboard-result-card">
                <div class="v-center d-flex justify-content-between" style="height:100%;">
                    <button class="card-icon card-section-container"
                            style="border-radius: 20px 0 0 20px;"
                            onclick="toggleFavorite()"
                            button-for="favorite">
                        <div class="v-center">
                            @* The favorite icon *@
                            <span
                                class="favoriteIconWrapper"
                                data-business-id="@business.BusinessId"
                                data-favorite-state="@Model.IsFavoriteBusiness(business)">
                                <i
                                    class="material-icons favoriteIcon animate-300 fadeIn noSelect"
                                    data-is-favorite="True">
                                    favorite
                                </i>
                                <i
                                    class="material-icons favoriteIcon animate-300 fadeIn noSelect"
                                    data-is-favorite="False">
                                    favorite_border
                                </i>
                            </span>
                        </div>
                    </button>
                    <div class="card-text card-section-container"
                         style="width: 50%;">
                        <div class="v-center">
                            <h4>@business.Name</h4>
                            <span>Tags</span>
                        </div>
                    </div>
                    <div class="card-text card-section-container"
                         style="width: 30%;">
                        <div class="v-center">
                            <p>@business.Address.Line1</p>
                            <p>@business.Address.City, @business.Address.ProvinceCode</p>
                        </div>
                    </div>
                    <button class="card-icon card-section-container"
                            style="border-radius: 0 20px 20px 0;"
                            button-for="select"
                            onclick="location.href='@Url.Action("StoreListings", "Dashboard", new { businessId = @business.BusinessId })'">
                        <div class="v-center">
                            <i class="material-icons arrowForwardIcon">
                                arrow_forward_ios
                            </i>
                        </div>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        function toggleFavorite() {            
            let span = $(event.currentTarget).find('div span');
            if ( span.attr("data-favorite-state") === "True" ) {
                span.attr("data-favorite-state", "False");
                
            } else if ( span.attr("data-favorite-state") === "False" ) {
                span.attr("data-favorite-state", "True");
            }
            
            let businessId = Number.parseInt(span.attr("data-business-id"));
            let isFavorite = span.attr("data-favorite-state") === "True";
            
            $.ajax({
                type: "POST",
                url: "/Dashboard/ToggleFavorite",
                data: {
                    businessId: businessId,
                    isFavorite: isFavorite
                },
                success: () => {
                    // We ignore the response not to reload the page
                }
            });
        }
    </script>
}