@model ICollection<Business>

@{
    ViewData["Title"] = "Dashboard - Stores";
}

<div class="dashboard-sidebar">
    
</div>
<div class="dashboard-center-container">
    
    <div class="dashboard-navigation">
        <div class="v-center">
            <button class="dashboard-nav-button dashboard-nav-button-active">Stores</button>
            <button class="dashboard-nav-button">Products</button>
        </div>
    </div>

    <div class="dashboard-results">
        @foreach (Business business in Model)
        {
            <div class="dashboard-result-card">
                <div class="v-center">
                    <div class="dashboard-result-card-left">
                        <h4>@business.Name</h4>
                        <p>Tags</p>
                    </div>
                    <div class="dashboard-result-card-right">
                        Test
                    </div>
                </div>
            </div>
        }
    </div>
    
    <div class="dashboard-page-nav">
        <a href="#"><</a><!--
        --><a href="#" class="active-page">1</a><!--
        --><a href="#">2</a><!--
        --><a href="#">3</a><!--
        --><a href="#">4</a><!--
        --><a href="#">5</a><!--
        --><a href="#">></a>
    </div>
</div>

