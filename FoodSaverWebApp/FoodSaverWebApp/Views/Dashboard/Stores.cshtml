<style>
    .favoriteIconWrapper {
        display: inline-block;
    }

    .favoriteIconWrapper[data-favorite-state="True"] .favoriteIcon[data-is-favorite="True"],
    .favoriteIconWrapper[data-favorite-state="False"] .favoriteIcon[data-is-favorite="False"] {
        display: inline-block;
    }
    
    .favoriteIconWrapper[data-favorite-state="True"] .favoriteIcon[data-is-favorite="False"],
    .favoriteIconWrapper[data-favorite-state="False"] .favoriteIcon[data-is-favorite="True"] {
        display: none;
    }
    
    .favoriteIcon {
        cursor: pointer;
    }
        
    .favoriteIcon[data-is-favorite="True"] {
        color: red;
    }
    
    .favoriteIcon[data-is-favorite="False"] {
        color: gray;
    }
</style>

@section Scripts{
    <script type="text/javascript">
        function toggleFavorite() {            
            let span = $(event.currentTarget);
            if ( span.attr("data-favorite-state") === "True" ) {
                span.attr("data-favorite-state", "False");
                
            } else if ( span.attr("data-favorite-state") === "False" ) {
                span.attr("data-favorite-state", "True");
            }
            
            let businessId = Number.parseInt(span.attr("data-business-id"));
            let isFavorite = span.attr("data-favorite-state") === "True";
            
            $.ajax({
                type: "POST",
                url: "/Dashboard/ToggleFavorite",
                data: {
                    businessId: businessId,
                    isFavorite: isFavorite
                },
                success: () => {
                    console.log("The request was successful");
                },
                error: () => {
                    // Flips back the favorite button if an error occurs
                    let span = $(event.currentTarget);
                    if ( span.attr("data-favorite-state") === "True" ) {
                        span.attr("data-favorite-state", "False");
                        
                    } else if ( span.attr("data-favorite-state") === "False" ) {
                        span.attr("data-favorite-state", "True");
                    }    
                }
            });
        }
    </script>
}