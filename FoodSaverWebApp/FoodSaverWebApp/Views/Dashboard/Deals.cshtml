@model ICollection<Item>

@{
    ViewData["Title"] = "Dashboard - Deals";
}

<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
</div>

<a asp-action="Stores" asp-controller="Dashboard">Stores</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Location</th>
        <th>Business</th>
    </tr>
    </thead>
    
    <tbody>
    @foreach (Item? item in Model)
    {
        DiscountInfo? itemDiscount = item.ActiveDiscount();
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>
                @if (itemDiscount != null)
                {
                    <span>@($"{itemDiscount.Price:c}") (@((100 / item.StandardPrice) * itemDiscount.Price)% off)</span>
                }
                else
                {
                    @($"{item.StandardPrice:c}")
                }
            </td>
            <td>@item.Business.Address.City, @item.Business.Address.Line1</td>
            <td>@item.Business.Name</td>
        </tr>
    }
    </tbody>
</table>
