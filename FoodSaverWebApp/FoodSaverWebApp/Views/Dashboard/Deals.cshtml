@model ICollection<DiscountInfo>

@{
    ViewData["Title"] = "Dashboard - Deals";
}

<div class="text-center">
    <h1 class="display-4">@ViewData["Title"]</h1>
</div>

<a asp-action="Stores" asp-controller="Dashboard">Stores</a>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Location</th>
        <th>Business</th>
    </tr>
    </thead>

    <tbody>
    @foreach (DiscountInfo deal in Model)
    {
        <tr>
            <td>@deal.Item.Name</td>
            <td>@deal.Item.Description</td>
            <td>
                @if (deal.Item.StandardPrice != null)
                {
                    <span><del>@($"{deal.Item.StandardPrice:c}")</del> @($"{deal.Price:c}") (@((100 / deal.Item.StandardPrice) * deal.Price)% off)</span>
                }
                else
                {
                    @($"{deal.Price:c}")
                }
            </td>
            <td>@deal.Item.Business.Address.PresentAddress()</td>
            <td>@deal.Item.Business.Name</td>
        </tr>
    }
    </tbody>
</table>