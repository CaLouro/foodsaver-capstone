@model FoodSaverWebApp.Models.LoginModel

@{
    ViewData["Title"] = "Login";
}

<div class="row d-flex justify-content-center">
    <div class="login-card animate-300 slideDown">
        <h1>Login</h1>
        
        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control"/>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" type="password"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="d-flex row-cols-2 justify-content-between">
                    <input type="submit" value="Login" class="btn btn-primary col-7"/>
                    <a asp-action="Registration" asp-controller="Auth" class="btn col-4">Sign Up</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
