@model StoreModel

@{
    ViewBag.Title = "Register Store";
}

<div class="row">
    <div class="login-card col-lg-6">
        <h1>Register Store</h1>
        
        <form asp-action="AdminRegisterStore">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            
            <div class="section-header">
                <p>Contact Info</p>
                <hr />
            </div>
            <div class="form-group">
                <label asp-for="Business.Name" class="control-label">Name</label>
                <input asp-for="Business.Name" class="form-control"/>
                <span asp-validation-for="Business.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Business.ContactEmail" class="control-label">Contact Email <span class="optional">(Optional)</span></label>
                <input asp-for="Business.ContactEmail" class="form-control" type="email"/>
                <span asp-validation-for="Business.ContactEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Business.ContactPhone" class="control-label">Contact Phone <span class="optional">(Optional)</span></label>
                <input asp-for="Business.ContactPhone" 
                       class="form-control"
                       type="phone"/>
                <span asp-validation-for="Business.ContactPhone" class="text-danger"></span>
            </div>
            <div class="section-header">
                <p>Business Tags</p>
                <hr />
            </div>
            <div class="form-group" style="margin: 1.5rem 0 1.5rem 0; padding: 0.5rem 0">
                <a class="list-toggler" id="list-toggler" toggled="false" onclick="list_toggler()">Select tags</a>
                <div id="checkbox-list">
                    @for (int i = 0; i < Model.TagItems.Count; i++)
                    {
                        <div class="list-item">
                            @Html.CheckBoxFor(m => m.TagItems[i].Selected)
                            @Html.LabelFor(m => m.TagItems[i].Selected, Model.TagItems[i].Text)
                            @Html.HiddenFor(m => m.TagItems[i].Value)
                        </div>
                        @if (i != Model.TagItems.Count - 1)
                        {
                            <hr style="margin: 0.25rem 0 0.25rem 0; padding: 0;">
                        }
                    }
                </div>
            </div>
            <div class="section-header">
                <p>Address Info</p>
                <hr />
            </div>
            <div class="form-group">
                <label asp-for="Business.Address.Line1" class="control-label">Line 1</label>
                <input asp-for="Business.Address.Line1" class="form-control" type="text"/>
                <span asp-validation-for="Business.Address.Line1" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Business.Address.Line2" class="control-label">Line 2 <span class="optional">(Optional)</span></label>
                <input asp-for="Business.Address.Line2" class="form-control" type="text"/>
                <span asp-validation-for="Business.Address.Line2" class="text-danger"></span>
            </div>
            <div class="form-group" style="margin: 0;">
                <label asp-for="Business.Address.City" class="control-label">City</label>
                <div class="d-flex justify-content-between" style="margin-top: 0;">
                    <div class="form-group" style="width: 48%; display: inline-block;">
                        <input asp-for="Business.Address.City"
                               class="form-control"
                               type="text"/>
                        <span asp-validation-for="Business.Address.City" class="text-danger"></span>
                    </div>
                    <div class="form-group" style="width: 48%; display: inline-block;">
                        <select asp-for="Business.Address.ProvinceCode"
                                asp-items="@(new SelectList(Model.ProvinceCodes))"
                                class="form-dropdown"
                                style="width: 100%;">
                            <option>Select a province</option>
                        </select>
                        <span asp-validation-for="Business.Address.ProvinceCode" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Business.Address.PostalCode" class="control-label">Postal Code</label>
                <input asp-for="Business.Address.PostalCode" class="form-control" type="text"/>
                <span asp-validation-for="Business.Address.PostalCode" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="d-flex row-cols-1">
                    <input type="submit" value="Register" class="btn btn-primary"/>
                </div>
            </div>
        </form>
    </div>
    <div class="login-form-image col-lg-6">
        <div class="image-overlay"></div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        let checkbox_list = document.getElementById("checkbox-list");
        let list_toggle = document.getElementById("list-toggler");
        function list_toggler() {
            checkbox_list.style['display'] = checkbox_list.style['display'] === 'block' ? 'none' : 'block';
        }
        document.body.onmousedown = function() {
            if (checkbox_list.parentNode.querySelector(":hover") !== checkbox_list && 
                list_toggle.parentNode.querySelector(":hover") !== list_toggle){
                checkbox_list.style['display'] = 'none';
            }
        }
            
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
