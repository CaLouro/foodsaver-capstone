@model DiscountFormModel

@{
    ViewBag.Title = "Add Discount";
}

<div class="row">
    <div class="login-card col-lg-6">
        <h1>New Discount</h1>

        <form asp-action="AdminAddDiscount">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label class="control-label" asp-for="DiscountInfo.Item">Item</label>
                <select asp-for="DiscountInfo.Item" class="form-control form-select">
                    <option selected>Choose An Item</option>
                    @foreach (var item in Model.Items)
                    {
                        <option value="@item">@item.Name</option>
                    }
                </select>
                <span asp-validation-for="DiscountInfo.Item" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiscountInfo.QuantityAvailable" class="control-label">Quantity Available</label>
                <input asp-for="DiscountInfo.QuantityAvailable" class="form-control" type="number"/>
                <span asp-validation-for="DiscountInfo.QuantityAvailable" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiscountInfo.Price" class="control-label">Price</label>
                <input asp-for="DiscountInfo.Price" class="form-control" type="number"/>
                <span asp-validation-for="DiscountInfo.Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiscountInfo.AvailabilityStarts" class="control-label">Availability Starts</label>
                <input asp-for="DiscountInfo.AvailabilityStarts" class="form-control" type="date"/>
                <span asp-validation-for="DiscountInfo.AvailabilityStarts" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DiscountInfo.AvailabilityEnds" class="control-label">Availability Ends</label>
                <input asp-for="DiscountInfo.AvailabilityEnds" class="form-control" type="date"/>
                <span asp-validation-for="DiscountInfo.AvailabilityEnds" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div class="d-flex row-cols-1">
                    <input type="submit" value="Add" class="btn btn-primary"/>
                </div>
            </div>
        </form>
    </div>
    <div class="login-form-image col-lg-6">
        <div class="image-overlay"></div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}