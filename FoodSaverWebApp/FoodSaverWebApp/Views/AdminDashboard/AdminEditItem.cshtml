@model Item

@{
    ViewBag.Title = "Edit Item";
}

<a asp-action="AdminStoreItems" asp-controller="AdminDashboard" asp-route-businessId="@Model.BusinessId">Back</a>
<div class="row">
    <div class="login-card col-lg-6">
        <h1>Edit Item</h1>
        
        <form asp-action="AdminEditItem">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="Name" class="control-label">Name</label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Description</label>
                <input asp-for="Description" class="form-control" type="text"/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StandardPrice" class="control-label">Standard Price</label>
                <input asp-for="StandardPrice" class="form-control" type="number"/>
                <span asp-validation-for="StandardPrice" class="text-danger"></span>
            </div>
            
            <input asp-for="ItemId" value="@Model.ItemId" hidden />
            <input asp-for="BusinessId" value="@Model.BusinessId" hidden />
            
            <div class="form-group">
                <div class="d-flex row-cols-2 justify-content-between">
                    <a asp-action="AdminStoreItems"
                       asp-controller="AdminDashboard"
                       asp-route-businessId="@Model.Business.BusinessId"
                       class="btn col-4">Cancel</a>
                    <input type="submit" value="Update" class="btn btn-primary col-7"/>
                </div>
            </div>
        </form>
    </div>
    <div class="login-form-image col-lg-6">
        <div class="image-overlay"></div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
