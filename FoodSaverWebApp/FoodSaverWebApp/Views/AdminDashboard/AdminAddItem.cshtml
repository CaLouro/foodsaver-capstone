@model Item

@{
    ViewBag.Title = "Add Item";
}

<a asp-action="AdminStoreItems" asp-controller="AdminDashboard" asp-route-businessId="@Model.BusinessId">Back</a>
<div class="row d-flex justify-content-center">
    <div class="login-card">
        <h1>New Item</h1>
        
        <form asp-action="AdminAddItem">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group">
                <label asp-for="Name" class="control-label">Name</label>
                <input asp-for="Name" class="form-control"/>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label">Description</label>
                <input asp-for="Description" class="form-control" type="text"/>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StandardPrice" class="control-label">Standard Price</label>
                <input asp-for="StandardPrice" class="form-control" type="number"/>
                <span asp-validation-for="StandardPrice" class="text-danger"></span>
            </div>
            
            <input asp-for="BusinessId" value="@Model.BusinessId" hidden />
            
            <div class="form-group">
                <div class="d-flex row-cols-1">
                    <input type="submit" value="Add" class="btn btn-primary"/>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
